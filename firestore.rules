rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ─────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isPharmacyOwner(pharmacyId) {
      return isAuthenticated();
    }

    // ── Users (Canonical Identity) ───────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── Fast Index ───────────────────────────────────────────
    match /pharmacyIndex/{pharmacyId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ── Root Products & Stock (Public for Customer App & Ecosystem Sync) ──
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /stock/{stockId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ── Root Pharmacies Collection (and all subcollections) ──
    match /pharmacies/{pharmacyId} {
      allow read: if true;
      allow write: if isAuthenticated();

      match /{document=**} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // ── Hierarchical Mirror (cities > areas > pharmacies) ─────
    match /cities/{cityId}/areas/{areaId}/pharmacies/{pharmacyId} {
      allow read: if true;
      allow write: if isAuthenticated();

      match /{document=**} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // ── Direct Area Root Mirror (areas > pharmacies) ──────────
    match /areas/{areaId}/pharmacies/{pharmacyId} {
      allow read: if true;
      allow write: if isAuthenticated();

      match /{document=**} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // ── Orders (Quick-Commerce Ecosystem) ────────────────────
    match /orders/{orderId} {
      allow read, write: if isAuthenticated();
    }
  }
}
